function sla(string, lista) {
    listalista = [];

    for (let i = 0; i < string.length; i++) {
        for(let k of Object.entries(lista)) {
        if (k[0] === string[i]) {
            listalista[i] = k[1]
        } else if (string[i] !== "" && !isNaN(Number(string[i]))) {
            //console.log(typeof Number(string[i]))
            //let antiresenha = new gh(Number(string[i]))
            listalista[i] = new gh(Number(string[i]))
            //console.log(string[i] instanceof gh)
        } else
            listalista[i] = string[i]
        }

        
    }
    //console.log(listalista)
    return listalista
}

