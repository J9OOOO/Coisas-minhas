function TF(string, env) {
    string = tokenizar(string)
    string = porrinha(string, env)
    let lista = []
    let j = 0
    let res
    for(let i = 0; i < string.length; ++i) {
        let a = ftem(string[i])
        //console.log(i)
        if (a.tem) {
            res = fazalgoai(string, i, a.i)
            lista[j] = res.valor
            i = i + res.par
            ++j
        } else {
            lista[j] = string[i]
            ++j
        }
    }
    return lista
}

function pu(lista, fi) {
    let pro = 0
    let i = fi + 1
    do {
        if (lista[i] === "(" ) {
            ++pro
        }

        if (lista[i] === ")") {
            --pro
        }
        ++i
        if (i > lista.length) throw new Error("FECHA SAPORRA")
    }
    while(pro !== 0)
    //console.log(lista.slice(fi + 1, i))
    return i
}

