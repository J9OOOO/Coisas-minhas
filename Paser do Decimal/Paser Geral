function tokenizar(string) {
    let tokens = []
    let porrinha = false
    
    for (let i = 0; i < string.length; i++) {
        for(let j = 0; j < listaOp.length; j++) {
            if (string.startsWith(listaOp[j], i)) {
                
                if (listaOp[j] === "-" && (i === 0 || "+-*/^(".includes(string[i-1]))) {
                    porrinha = false
                    break
                }

                tokens.push(listaOp[j])
                i += listaOp[j].length - 1
                porrinha = true
                break
            }
        }

        if (!porrinha) {
            let ehSinal = string[i] === "-";
            let numero = ""

            if (ehSinal) {
                numero += "-"
                ++i
            }

            if (ehSinal || !isNaN(Number(string[i]))) {
                while (i < string.length && (!isNaN(Number(string[i])) || string[i] === ".")) {
                    numero += string[i]
                    ++i
                }
                tokens.push(new gh(numero))
                --i
            } else {
                tokens.push(string[i])
            }
        }
        porrinha = false
    }
    
    tokens = tokens.filter(x => x !== "")
    return tokens
}

function porrinha(lista, numero) {
    //if (!(numero instanceof gh) && typeof numero !== "Object") numero = gh(numero)
    for(let i = 0; i < lista.length; i++) {
        if (!isNaN(Number(lista[i]))) {
            lista[i] = new gh(lista[i])
        }
    }
    return lista.map(a => numero[a] instanceof gh ? numero[a] : a)
}

