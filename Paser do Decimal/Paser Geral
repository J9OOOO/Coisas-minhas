function TF(string) {
    let saborstring = []
    for(let i = 0; i < string.length; i++) {
        for(let j = 0; j < funcoes.length; j++) {
            //console.log(funcoes[j])
            if (funcoes[j].name === string[i]) {
                saborstring.push(funcoes[j](string[i+1]))
                saborstring[i+1] = ""
                ++i
            }
        }
        saborstring.push(string[i])
    }
    saborstring = saborstring.join("")
    return saborstring
}

