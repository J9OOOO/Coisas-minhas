function ftem(a) {
    let tem = false
    let ir = -1
    for(let i = 0; i < funcoes.length; ++i) {
        if (a === funcoes[i].name) {
            tem = true
            ir = i
        }
    }
    return {tem: tem, i: ir}
}

function fazalgoai(lista, fi, fnome) {
    let i = pu(lista, fi)
    //console.log(lista.slice(fi + 1, i), par.par.Dogivalizador(lista.slice(fi + 1, i)))
    let valor =  par.par.Dogivalizador(lista.slice(fi + 1, i))
    //console.log(funcoes[fnome])
    let fvalor = funcoes[fnome](valor)
    return {valor: fvalor, par: i - fi - 1}
}

