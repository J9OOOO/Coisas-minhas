function tokenizar(string) {
    let tokens = []
    let porrinha = false
     for (let i = 0; i < string.length; i++) {
        for(let j = 0; j < listaOp.length; j++) {
            if (string.startsWith(listaOp[j], i)) {
                //console.log("ACHOU", listaOp[j], "em", i)
            }
            if (string.startsWith(listaOp[j], i)) {
                tokens.push(listaOp[j])
                i += listaOp[j].length - 1
                porrinha = true
            break
        }
        }
        if (!porrinha) tokens[i] = string[i]
        porrinha = false
        //console.log(tokens)
    }
    tokens = tokens.filter(x => x !== "")
    return tokens
}

function porrinha(lista, numero) {
    if (!(numero instanceof gh)) numero = gh(numero)
    for(let i = 0; i < lista.length; i++) {
        if (!isNaN(Number(lista[i]))) {
            lista[i] = new gh(lista[i])
        }
    }
    return lista = lista.map(a => a === "x" ? numero : a)
}

function parser(x, string) {
    let a = tokenizar(string)
    let b = porrinha(a, new gh(x))
    let c = par.par.Dogivalizador(b)
    console.log(c)
}

